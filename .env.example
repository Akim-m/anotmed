# Copy to .env and adjust. Values shown are the defaults.

# Backend: "stub" (CPU, no weights) or "medgemma+medsam" (GPU, real models).
ANOTMED_BACKEND=stub

# Where studies, masks, and annotations are stored.
ANOTMED_STORAGE=./anotmed_data

# Max findings the localizer returns per image, and a score floor to drop weak ones.
ANOTMED_MAX_FINDINGS=8
ANOTMED_MIN_SCORE=0.0

# --- only read by the medgemma+medsam backend ---------------------------------
ANOTMED_DEVICE=cuda
ANOTMED_MEDGEMMA_MODEL=google/medgemma-4b-it
# Point these at your MedSAM-2 / SAM2 weights + model config:
ANOTMED_SAM_CHECKPOINT=/path/to/medsam2.pt
ANOTMED_SAM_CONFIG=/path/to/sam2_hiera_s.yaml
