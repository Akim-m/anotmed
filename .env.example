# Copy to .env and adjust. Values shown are the defaults.

# Backend: "stub" (CPU, no weights) or "medgemma+medsam" (GPU, real models).
ANOTMED_BACKEND=stub

# Where studies, masks, and annotations are stored.
ANOTMED_STORAGE=./anotmed_data

# Max findings the localizer returns per image, and a score floor to drop weak ones.
ANOTMED_MAX_FINDINGS=8
ANOTMED_MIN_SCORE=0.0

# --- real-model backends (medgemma+medsam, or vllm) ---------------------------
ANOTMED_DEVICE=cuda
ANOTMED_MEDGEMMA_MODEL=google/medgemma-4b-it
# Point these at your MedSAM-2 / SAM2 weights + model config:
ANOTMED_SAM_CHECKPOINT=/path/to/medsam2.pt
ANOTMED_SAM_CONFIG=/path/to/sam2_hiera_s.yaml

# Where the segmenter runs. On an 8 GB GPU, MedGemma (FP8) needs most of the card,
# so the reliable default there is CPU SAM2 (a few seconds per image, hidden by the
# async job model). Set to "cuda" only if the two models comfortably co-fit.
ANOTMED_SEG_DEVICE=cpu

# --- vLLM MedGemma backend (ANOTMED_BACKEND=vllm) -----------------------------
# MedGemma runs in a separate vLLM server (scripts/serve_vllm.sh); this is the client.
ANOTMED_VLLM_URL=http://127.0.0.1:8000/v1
ANOTMED_VLLM_TIMEOUT_S=120
ANOTMED_GUIDED_JSON=1

# --- detector backend (ANOTMED_BACKEND=detector+medsam) -----------------------
# A dedicated object detector is the Localizer (MedGemma stays as the Reporter).
# ANOTMED_MODALITY selects a profile (see anotmed/modalities.py) that supplies
# per-modality detector/window/labels/floors defaults; explicit knobs override it.
ANOTMED_MODALITY=            # e.g. dental (empty = generic)
ANOTMED_DETECTOR_WEIGHTS=/path/to/detector.pt
ANOTMED_DETECTOR_DEVICE=cuda
ANOTMED_DETECTOR_CONF=0.25
ANOTMED_DETECTOR_IMGSZ=1024
